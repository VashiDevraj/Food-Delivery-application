<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FoodDeliveryApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
        <item name="colorAccent">@color/accentColor</item>
        <item name="android:windowBackground">@color/bgWhite</item>
        <item name="android:statusBarColor">@color/primaryDark</item>
    </style>

    <!-- Splash Theme (no window animation) -->
    <style name="Theme.FoodDeliveryApp.Splash" parent="Theme.FoodDeliveryApp">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Button Styles -->
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/primaryColor</item>
        <item name="android:textColor">@color/textWhite</item>
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">@dimen/button_radius</item>
    </style>

    <!-- Input Field Style -->
    <style name="InputField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primaryColor</item>
        <item name="hintTextColor">@color/primaryColor</item>
    </style>

    <!-- Card Style -->
    <style name="AppCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardBackgroundColor">@color/bgCard</item>
    </style>

</resources>