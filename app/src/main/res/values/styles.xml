<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RoundedAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/RoundedDialogShape</item>
    </style>

    <style name="RoundedDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="colorPrimary">#E23744</item>
    </style>
    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
    </style>
    <style name="AdminStatusDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#212121</item>
        <item name="colorPrimary">#E23744</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="buttonBarPositiveButtonStyle">@style/RedButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/GhostButtonStyle</item>
    </style>
    <style name="RedButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#E23744</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="GhostButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#888888</item>
    </style>
</resources>