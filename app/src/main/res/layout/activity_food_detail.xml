<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#E23744"
            app:titleTextColor="#FFFFFF"
            app:navigationIconTint="#FFFFFF"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Food Image with rounded bottom corners effect -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/ivFoodImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Food Image"
                    android:scaleType="centerCrop"
                    android:background="#FFE0B2"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Food Name -->
                    <TextView
                        android:id="@+id/tvFoodName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Food Name"
                        android:textColor="#1A1A1A"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <!-- Unit Price -->
                    <TextView
                        android:id="@+id/tvUnitPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="₹0.00 per item"
                        android:textColor="#E23744"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="#F0F0F0" />

                    <!-- Description Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textColor="#E23744"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10"/>

                    <!-- Description Text -->
                    <TextView
                        android:id="@+id/tvFoodDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Description here..."
                        android:textColor="#757575"
                        android:textSize="14sp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="#F0F0F0" />

                    <!-- Quantity Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Select Quantity"
                        android:textColor="#E23744"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10"/>

                    <!-- Quantity + Total row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Decrease -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDecrease"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            app:backgroundTint="#E23744"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:text="−"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            app:cornerRadius="12dp" />

                        <!-- Quantity Display -->
                        <TextView
                            android:id="@+id/tvQuantity"
                            android:layout_width="56dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#1A1A1A"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- Increase -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIncrease"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            app:backgroundTint="#E23744"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            app:cornerRadius="12dp" />

                        <View android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="1dp"/>

                        <!-- Total Price Badge -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="#FFF3E0"
                            app:cardElevation="0dp">
                            <TextView
                                android:id="@+id/tvTotalPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: ₹0.00"
                                android:textColor="#E65100"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"/>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom: Add to Cart Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="#E23744"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🛒  ADD TO CART"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#E23744"
            app:cornerRadius="16dp"
            app:elevation="4dp"/>

    </LinearLayout>

</LinearLayout>