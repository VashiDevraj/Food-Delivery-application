<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="6dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#E23744"
            app:titleTextColor="#FFFFFF"
            app:navigationIconTint="#FFFFFF"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:id="@+id/tvCommentCharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/300"
                android:textColor="#9E9E9E"/>

            <TextView
                android:id="@+id/tvReviewTipBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tip ₹0"
                android:visibility="gone"/>

            <!-- Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#E23744">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐"
                        android:textSize="36sp"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:id="@+id/tvReviewRestaurantName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Restaurant"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:gravity="center"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Share your experience with others 🙏"
                        android:textColor="#FFCDD2"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Food Rating -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="🍽️" android:textSize="18sp" android:gravity="center"
                            android:layout_marginEnd="10dp"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Food Quality"
                            android:textColor="#212121" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvFoodRatingLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tap to rate" android:textColor="#E23744" android:textSize="12sp"/>
                    </LinearLayout>
                    <RatingBar android:id="@+id/rbFoodRating"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:numStars="5" android:stepSize="1" android:rating="0"
                        android:progressTint="#E23744" android:secondaryProgressTint="#FFCDD2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delivery Rating -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="🛵" android:textSize="18sp" android:gravity="center"
                            android:layout_marginEnd="10dp"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Delivery Experience"
                            android:textColor="#212121" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvDeliveryRatingLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tap to rate" android:textColor="#E23744" android:textSize="12sp"/>
                    </LinearLayout>
                    <RatingBar android:id="@+id/rbDeliveryRating"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:numStars="5" android:stepSize="1" android:rating="0"
                        android:progressTint="#E23744" android:secondaryProgressTint="#FFCDD2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Packing Rating -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="📦" android:textSize="18sp" android:gravity="center"
                            android:layout_marginEnd="10dp"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Packing Quality"
                            android:textColor="#212121" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvPackingRatingLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tap to rate" android:textColor="#E23744" android:textSize="12sp"/>
                    </LinearLayout>
                    <RatingBar android:id="@+id/rbPackingRating"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:numStars="5" android:stepSize="1" android:rating="0"
                        android:progressTint="#E23744" android:secondaryProgressTint="#FFCDD2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delivery Boy Rating (shown only if deliveryBoyId exists) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDeliveryBoyRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFF8E1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="🏍️" android:textSize="18sp" android:gravity="center"
                            android:layout_marginEnd="10dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Delivery Partner"
                                android:textColor="#212121" android:textSize="15sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvDeliveryBoyName"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#E65100" android:textSize="12sp"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvDeliveryBoyRatingLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tap to rate" android:textColor="#F57C00" android:textSize="12sp"/>
                    </LinearLayout>
                    <RatingBar android:id="@+id/rbDeliveryBoyRating"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:numStars="5" android:stepSize="1" android:rating="0"
                        android:progressTint="#F57C00" android:secondaryProgressTint="#FFE0B2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Comment -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="✍️" android:textSize="18sp" android:gravity="center"
                            android:layout_marginEnd="10dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Your Comment (optional)"
                            android:textColor="#212121" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tell others about your experience…"
                        app:boxStrokeColor="#E23744"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReviewComment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:maxLines="6"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Photo Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="📷" android:textSize="18sp" android:gravity="center"
                            android:layout_marginEnd="10dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Add a Photo (optional)"
                                android:textColor="#212121" android:textSize="15sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Photo of your food helps others decide"
                                android:textColor="#9E9E9E" android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Placeholder (camera icon area) -->
                    <FrameLayout
                        android:id="@+id/layoutPhotoPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="#FFF3F3"
                        android:layout_marginBottom="10dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="📸" android:textSize="40sp" android:gravity="center"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Tap below to take a photo"
                                android:textColor="#BDBDBD" android:textSize="12sp"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Photo Preview -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPhotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone"
                        app:cardCornerRadius="10dp">
                        <ImageView
                            android:id="@+id/ivReviewPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Review photo"/>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTakePhoto"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:text="📷 Take Photo"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            app:backgroundTint="#E23744"
                            app:cornerRadius="10dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRemovePhoto"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="Remove"
                            android:textColor="#E23744"
                            android:textSize="13sp"
                            app:strokeColor="#E23744"
                            app:cornerRadius="10dp"/>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Submit button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:padding="14dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReview"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Submit Review ⭐"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#E23744"
            app:cornerRadius="14dp"/>
    </LinearLayout>

</LinearLayout>