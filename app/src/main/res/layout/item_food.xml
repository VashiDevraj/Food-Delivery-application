<?xml version="1.0" encoding="utf-8"?>
<!--
  item_food.xml — Swiggy/Zomato style food card
  • Large image fills top 60%
  • Name + price below
  • ADD button floats on bottom-right of image (like Swiggy)
  • Heart favourite on top-right corner
  • Veg/NonVeg dot indicator
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Image section with ADD button overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp">

            <!-- Food Image -->
            <ImageView
                android:id="@+id/ivFoodImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_food_placeholder"
                android:contentDescription="Food Image"/>

            <!-- Gradient overlay at bottom so text/button is readable -->
            <View
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_bottom_dark"/>

            <!-- Heart favourite — top right -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#DDFFFFFF"
                app:cardElevation="2dp">
                <ImageView
                    android:id="@+id/ivFoodFavourite"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_favorite_border"
                    android:padding="6dp"
                    android:contentDescription="Add to favourites"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- ADD button — bottom right, floats on image -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddToCart"
                    android:layout_width="76dp"
                    android:layout_height="34dp"
                    android:text="ADD +"
                    android:textColor="#E23744"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    app:cornerRadius="8dp"/>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- Name + Price row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Food Name"
                android:textColor="#1A1A1A"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvFoodPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹0"
                android:textColor="#E23744"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>