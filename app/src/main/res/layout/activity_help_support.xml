<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_help_support.xml — CRASH FIX
    Root cause identical to ChangePasswordActivity and SettingsActivity:
      ?attr/colorSurface, ?attr/colorOnSurface, ?attr/colorOnSurfaceVariant
      cannot be resolved by MaterialCardView / MaterialButton constructors at
      inflation time inside a Theme.MaterialComponents.Light theme, throwing:
        java.lang.UnsupportedOperationException: Failed to resolve attribute …

    Fix: Replace every ?attr/color* with explicit hex literals.
         Swap MaterialCardView → androidx.cardview.widget.CardView
         (CardView never resolves colour-scheme attrs in its constructor).
         MaterialButton is safe to keep but app:backgroundTint must be a
         literal colour, not a theme reference.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ── Toolbar ────────────────────────────────────────────────────────── -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#E23744"
        android:elevation="4dp"
        app:titleTextColor="#FFFFFF"
        app:navigationIconTint="#FFFFFF"
        app:title="Help &amp; Support" />

    <!-- ── Scrollable body ────────────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ════════════════════════════════════════════════════════════
                 HERO
                 ════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- Icon bubble -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_icon_red_soft" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="❓"
                        android:textSize="32sp"
                        android:gravity="center" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How can we help you?"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse topics below or contact us directly"
                    android:textSize="13sp"
                    android:textColor="#757575"
                    android:layout_marginTop="6dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- ════════════════════════════════════════════════════════════
                 FAQ
                 ════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FREQUENTLY ASKED QUESTIONS"
                android:textColor="#E23744"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:paddingBottom="8dp" />

            <!--
                CRASH FIX: was MaterialCardView with
                  app:strokeColor="?attr/colorOnSurfaceVariant"
                  app:cardBackgroundColor="?attr/colorSurface"
                → replaced with CardView + literal colours.
            -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Where is my order? -->
                    <LinearLayout
                        android:id="@+id/llFaqOrder"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="📦"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:background="@drawable/bg_icon_amber_soft"
                            android:layout_marginEnd="14dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Where is my order?"
                            android:textSize="14sp"
                            android:textColor="#1A1A1A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="18sp"
                            android:textColor="#E23744" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginStart="58dp" />

                    <!-- Payment issues -->
                    <LinearLayout
                        android:id="@+id/llFaqPayment"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="💳"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:background="@drawable/bg_icon_blue_soft"
                            android:layout_marginEnd="14dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Payment issues or failed transactions"
                            android:textSize="14sp"
                            android:textColor="#1A1A1A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="18sp"
                            android:textColor="#E23744" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginStart="58dp" />

                    <!-- Cancel order -->
                    <LinearLayout
                        android:id="@+id/llFaqCancel"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="❌"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:background="@drawable/bg_icon_red_soft"
                            android:layout_marginEnd="14dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="How to cancel an order?"
                            android:textSize="14sp"
                            android:textColor="#1A1A1A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="18sp"
                            android:textColor="#E23744" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginStart="58dp" />

                    <!-- Refund -->
                    <LinearLayout
                        android:id="@+id/llFaqRefund"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="💰"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:background="@drawable/bg_icon_green_soft"
                            android:layout_marginEnd="14dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Refunds and returns"
                            android:textSize="14sp"
                            android:textColor="#1A1A1A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="18sp"
                            android:textColor="#E23744" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ════════════════════════════════════════════════════════════
                 CONTACT US
                 ════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTACT US"
                android:textColor="#E23744"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:paddingBottom="8dp" />

            <!--
                CRASH FIX: same as above — CardView + literal colours.
            -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Email -->
                    <LinearLayout
                        android:id="@+id/llContactEmail"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="📧"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:background="@drawable/bg_icon_red_soft"
                            android:layout_marginEnd="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Email support"
                                android:textSize="14sp"
                                android:textColor="#1A1A1A"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="support@foodapp.com"
                                android:textSize="12sp"
                                android:textColor="#757575" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="18sp"
                            android:textColor="#E23744" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginStart="58dp" />

                    <!-- Phone -->
                    <LinearLayout
                        android:id="@+id/llContactPhone"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="📞"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:background="@drawable/bg_icon_green_soft"
                            android:layout_marginEnd="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Call us"
                                android:textSize="14sp"
                                android:textColor="#1A1A1A"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1800-XXX-XXXX  •  Toll free, 9AM–9PM"
                                android:textSize="12sp"
                                android:textColor="#757575" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="18sp"
                            android:textColor="#E23744" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginStart="58dp" />

                    <!-- Live chat -->
                    <LinearLayout
                        android:id="@+id/llContactChat"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="💬"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:background="@drawable/bg_icon_blue_soft"
                            android:layout_marginEnd="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Live chat"
                                android:textSize="14sp"
                                android:textColor="#1A1A1A"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Available Mon–Sat, 9AM–6PM"
                                android:textSize="12sp"
                                android:textColor="#757575" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="18sp"
                            android:textColor="#E23744" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Live Chat button ────────────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLiveChat"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Start Live Chat"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#E23744"
                app:cornerRadius="14dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp" />

            <!--
                CRASH FIX: app:backgroundTint was "?attr/colorSurface"
                → replaced with literal "#FFFFFF".
                MaterialButton resolves backgroundTint in its constructor,
                so a theme reference that can't be resolved causes the same
                UnsupportedOperationException crash.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmailSupport"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Email Support"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#E23744"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#E23744"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>