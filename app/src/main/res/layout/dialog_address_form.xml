<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_address_form.xml — Add / Edit address
    Binding: DialogAddressFormBinding
    IDs: tvFormTitle, etLabel, tilHouseNo, etHouseNo, tilStreet, etStreet,
         etLandmark, tilLandmark, tilCity, etCity, tilPincode, etPincode,
         btnSaveAddress, btnCancel
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_handle_bar"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍  Add New Address"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="18dp" />

        <!-- Label -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Label (e.g. Home, Work)"
            app:boxStrokeColor="#E23744"
            app:hintTextColor="#E23744"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#212121"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- House No -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHouseNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="House No / Flat / Block *"
            app:boxStrokeColor="#E23744"
            app:hintTextColor="#E23744"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHouseNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#212121"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Street -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStreet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Street / Area / Colony *"
            app:boxStrokeColor="#E23744"
            app:hintTextColor="#E23744"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStreet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#212121"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Landmark -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLandmark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Landmark (optional)"
            app:boxStrokeColor="#E23744"
            app:hintTextColor="#E23744"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLandmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#212121"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- City + Pincode -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCity"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:hint="City *"
                app:boxStrokeColor="#E23744"
                app:hintTextColor="#E23744"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="#212121"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPincode"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Pincode *"
                app:boxStrokeColor="#E23744"
                app:hintTextColor="#E23744"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPincode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textColor="#212121"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAddress"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save Address"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"
            app:backgroundTint="#E23744"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="#E23744"
            android:textSize="14sp"
            app:backgroundTint="#FFF5F5"
            app:strokeColor="#E23744"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp" />

    </LinearLayout>

</ScrollView>