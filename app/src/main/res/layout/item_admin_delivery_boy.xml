<?xml version="1.0" encoding="utf-8"?>
<!-- item_admin_delivery_boy.xml — colorful delivery partner card -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header strip: orange for online, grey for offline -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="6dp"
            android:id="@+id/viewStatusBar"
            android:background="#FF6F00" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Top row: name + status chip -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="#FFF3E0"
                    android:layout_marginEnd="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🛵" android:textSize="22sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView android:id="@+id/tvBoyName"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#212121" android:textSize="15sp" android:textStyle="bold" />

                    <TextView android:id="@+id/tvBoyVehicle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#757575" android:textSize="12sp" android:layout_marginTop="2dp" />

                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBoyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Offline"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:chipStrokeWidth="0dp" />

            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#F5F5F5" android:layout_marginBottom="10dp" />

            <!-- Stats row: rating / deliveries / earnings -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">

                <!-- Rating -->
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:gravity="center" android:background="#FFF8E1"
                    android:padding="8dp" android:layout_marginEnd="6dp">

                    <TextView android:id="@+id/tvBoyRating"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#F57F17" android:textSize="14sp" android:textStyle="bold"
                        android:gravity="center" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Rating" android:textColor="#9E9E9E" android:textSize="10sp"
                        android:gravity="center" android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- Deliveries -->
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:gravity="center" android:background="#E3F2FD"
                    android:padding="8dp" android:layout_marginEnd="6dp">

                    <TextView android:id="@+id/tvBoyDeliveries"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#1565C0" android:textSize="14sp" android:textStyle="bold"
                        android:gravity="center" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Deliveries" android:textColor="#9E9E9E" android:textSize="10sp"
                        android:gravity="center" android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- Earnings -->
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:gravity="center" android:background="#E8F5E9"
                    android:padding="8dp">

                    <TextView android:id="@+id/tvBoyEarnings"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#2E7D32" android:textSize="13sp" android:textStyle="bold"
                        android:gravity="center" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Earned" android:textColor="#9E9E9E" android:textSize="10sp"
                        android:gravity="center" android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Phone -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="#F5F5F5" android:padding="10dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📞  " android:textSize="13sp" />

                <TextView android:id="@+id/tvBoyPhone"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#1565C0" android:textSize="14sp" android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>