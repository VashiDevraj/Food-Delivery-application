<?xml version="1.0" encoding="utf-8"?>
<!-- item_earning_history.xml — bright green earning card -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E8F5E9"
    app:strokeWidth="1.5dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">

        <!-- Green rupee icon -->
        <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:background="#2E7D32"
            android:layout_marginEnd="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="₹" android:textSize="22sp" android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Centre info -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">

            <TextView android:id="@+id/tvEarningOrderId"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#212121" android:textSize="14sp" android:textStyle="bold"/>

            <TextView android:id="@+id/tvEarningRestaurant"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#616161" android:textSize="12sp" android:layout_marginTop="2dp"/>

            <TextView android:id="@+id/tvEarningDate"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#BDBDBD" android:textSize="11sp" android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Right: total + breakdown -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">

            <TextView android:id="@+id/tvEarningTotal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#2E7D32" android:textSize="18sp" android:textStyle="bold"/>

            <TextView android:id="@+id/tvEarningBreakdown"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#9E9E9E" android:textSize="11sp" android:layout_marginTop="2dp"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>