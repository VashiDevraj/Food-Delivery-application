<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F4F4">

    <!-- ══ RED TOP HEADER ══ -->
    <LinearLayout
        android:id="@+id/layoutSuccessHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E23744"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="28dp"
        android:elevation="4dp">

        <!-- Animated tick circle -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="6dp"
            android:layout_marginBottom="14dp">
            <TextView
                android:id="@+id/tvSuccessTick"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="✓"
                android:textColor="#4CAF50"
                android:textSize="36sp"
                android:textStyle="bold"
                android:gravity="center" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Placed! 🎉"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvSuccessOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#ORDER"
            android:textColor="#FFCDD2"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ══ SCROLL BODY ══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ── Estimated delivery card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="🛵"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimated Delivery"
                            android:textColor="#757575"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDeliveryEta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30-40 mins"
                            android:textColor="#212121"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Live tracker dots -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View android:id="@+id/dotOrdered"
                            android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_dot_active"
                            android:layout_marginEnd="4dp" />
                        <View android:layout_width="16dp" android:layout_height="2dp"
                            android:background="#E0E0E0" android:layout_marginEnd="4dp" />
                        <View android:id="@+id/dotPreparing"
                            android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_dot_inactive"
                            android:layout_marginEnd="4dp" />
                        <View android:layout_width="16dp" android:layout_height="2dp"
                            android:background="#E0E0E0" android:layout_marginEnd="4dp" />
                        <View android:id="@+id/dotDelivered"
                            android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/bg_dot_inactive" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Restaurant + food summary card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="🏪"
                            android:textSize="16sp"
                            android:gravity="center"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/tvSuccessRestaurantName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Restaurant"
                            android:textColor="#212121"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Food items list (populated dynamically) -->
                    <LinearLayout
                        android:id="@+id/llOrderedItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Food images horizontal scroll -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="10dp">
                        <LinearLayout
                            android:id="@+id/llFoodImages"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Bill summary card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bill Summary"
                        android:textColor="#212121"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Order Total" android:textColor="#757575" android:textSize="13sp" />
                        <TextView android:id="@+id/tvBillTotal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹0.00" android:textColor="#212121" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/layoutBillDiscount"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Discount" android:textColor="#4CAF50" android:textSize="13sp" />
                        <TextView android:id="@+id/tvBillDiscount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="-₹0" android:textColor="#4CAF50" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Payment" android:textColor="#757575" android:textSize="13sp" />
                        <TextView android:id="@+id/tvBillPaymentMethod"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="COD" android:textColor="#212121" android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#EEEEEE" android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Amount Paid"
                            android:textColor="#212121" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvBillAmountPaid"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="#E23744" android:textSize="15sp" android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Download Bill PDF button ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadBill"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:text="📄  Download Bill PDF"
                android:textColor="#E23744"
                android:textSize="14sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                app:strokeColor="#E23744"
                app:strokeWidth="1dp" />

            <!-- ── Go to Home button ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoHome"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="6dp"
                android:text="Back to Home"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#E23744"
                app:cornerRadius="12dp" />

            <!-- ── View Order History ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewOrders"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="16dp"
                android:text="View Order History"
                android:textColor="#E23744"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>