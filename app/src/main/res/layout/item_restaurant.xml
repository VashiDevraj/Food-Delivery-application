<?xml version="1.0" encoding="utf-8"?>
<!--
    item_restaurant.xml
    FIX: tvRatingBadge now uses android:textColor="#FFFFFF" (white) as default.
    White text on a solid coloured badge is always readable — dark green on
    light green was the original low-contrast bug.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EEEEEE"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ══ IMAGE BANNER with overlays ══ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#FFEBEE">

            <ImageView
                android:id="@+id/ivRestaurantImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_food_placeholder" />

            <!-- Dim overlay so white badges sit on a consistent dark base -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33000000" />

            <!-- Heart favourite button — top left -->
            <ImageView
                android:id="@+id/ivRestaurantFavourite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:src="@drawable/ic_favorite_border"
                android:padding="4dp"
                android:background="#88FFFFFF"
                android:contentDescription="Add to favourites" />

            <!--
                Rating badge — top right.
                ★ KEY FIX: textColor is #FFFFFF (white).
                The adapter sets the background drawable (solid green / amber / red)
                based on rating value, so white text is always readable.
            -->
            <TextView
                android:id="@+id/tvRatingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="★ 4.2"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_rating_green" />

            <!-- Delivery time badge — bottom left -->
            <TextView
                android:id="@+id/tvDeliveryTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="🕐 30 min"
                android:textColor="#212121"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_delivery_badge" />

        </FrameLayout>

        <!-- ══ INFO SECTION ══ -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <!-- Row 1: Name + inline rating -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvRestaurantName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!--
                    Inline rating text (no background).
                    Adapter sets a dark, high-contrast color per rating tier
                    so it reads clearly against the white card surface.
                -->
                <TextView
                    android:id="@+id/tvRestaurantRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:paddingStart="6dp" />

            </LinearLayout>

            <!-- Row 2: City -->
            <TextView
                android:id="@+id/tvRestaurantCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#E23744"
                android:textStyle="bold"
                android:layout_marginBottom="3dp" />

            <!-- Row 3: Address / Veg label -->
            <TextView
                android:id="@+id/tvRestaurantAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#757575"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F5F5F5"
                android:layout_marginBottom="10dp" />

            <!-- Row 4: Delivery time + Free delivery -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕐"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvDeliveryTimeText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#555555" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free delivery"
                    android:textSize="11sp"
                    android:textColor="#2E7D32"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>