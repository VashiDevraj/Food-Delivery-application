<?xml version="1.0" encoding="utf-8"?>
<!--
    item_address_row.xml — one row in the address selector list
    IDs: rbAddress, btnEditAddress, btnDeleteAddress
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingStart="4dp"
    android:paddingEnd="0dp">

    <!-- Radio + address text -->
    <RadioButton
        android:id="@+id/rbAddress"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#333333"
        android:lineSpacingExtra="3dp"
        android:buttonTint="#E23744"
        android:paddingStart="8dp" />

    <!-- Edit button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditAddress"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        app:icon="@drawable/ic_edit"
        app:iconSize="16dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:text=""
        android:layout_marginEnd="4dp"
        app:backgroundTint="#FFF3E0"
        app:iconTint="#FF6F00"
        app:cornerRadius="18dp" />

    <!-- Delete button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteAddress"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        app:icon="@drawable/ic_delete"
        app:iconSize="16dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:text=""
        android:layout_marginEnd="4dp"
        app:backgroundTint="#FFEBEE"
        app:iconTint="#E23744"
        app:cornerRadius="18dp" />

</LinearLayout>