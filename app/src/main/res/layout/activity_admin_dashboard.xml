<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_admin_dashboard.xml
  Key additions vs original:
    • Vibrant gradient header
    • Restaurant STATUS CARD with open/close switch, schedule info, override indicator
    • "Set Schedule" and "Auto Schedule" buttons
    • All existing stats cards and quick actions preserved
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- ══ HEADER ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_gradient_red"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:elevation="8dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:id="@+id/tvAdminInitial"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_avatar_circle">
                <TextView
                    android:id="@+id/tvInitialLetter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="A"
                    android:textColor="#1565C0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvAdminName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome, Admin"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restaurant Owner"
                    android:textColor="#FFCDD2"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Notification bell -->
            <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNotifications"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardBackgroundColor="#C62828"
                    app:cardElevation="0dp">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                        android:text="🔔" android:textSize="18sp" android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tvNewOrderBadge"
                    android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    app:cardCornerRadius="9dp" app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="2dp" android:visibility="gone">
                    <TextView android:id="@+id/tvBadgeCount"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:text="0" android:textColor="#E23744" android:textSize="9sp"
                        android:textStyle="bold" android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </LinearLayout>

        <!-- Restaurant info mini-card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#CC000000"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/tvRestaurantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading restaurant..."
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/tvRestaurantCity"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#FFCDD2"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvVegBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#A5D6A7"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ══ SCROLLABLE BODY ══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══════════════════════════════════════════════
                 ❶  RESTAURANT STATUS CARD  (NEW)
                 ══════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESTAURANT STATUS"
                android:textColor="#757575"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRestaurantStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#E8F5E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Status row: label + toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRestaurantStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🟢 OPEN"
                                android:textColor="#2E7D32"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStatusSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Closes at 10:00 PM"
                                android:textColor="#757575"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchRestaurantOpen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="#FFFFFF"
                            app:trackTint="@color/switch_track_selector" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#20000000"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Schedule info row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvScheduleInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📅  9:00 AM  –  10:00 PM"
                                android:textColor="#424242"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOverrideLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏰ Auto-schedule"
                                android:textColor="#1565C0"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <!-- Set Schedule button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetSchedule"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Set Hours"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            app:backgroundTint="#1565C0"
                            app:cornerRadius="10dp"
                            android:layout_marginEnd="8dp" />

                        <!-- Auto schedule button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAutoSchedule"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Auto"
                            android:textSize="12sp"
                            android:textColor="#1565C0"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            app:backgroundTint="#E3F2FD"
                            app:cornerRadius="10dp"
                            app:strokeColor="#1565C0"
                            app:strokeWidth="1dp" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════
                 ❷  OVERVIEW STATS
                 ═══════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OVERVIEW"
                android:textColor="#757575"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp" />

            <!-- Stats Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="📦" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_stat_icon_red" android:layout_marginBottom="10dp" />
                        <TextView android:id="@+id/tvTotalOrders" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="#E23744" android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Total Orders" android:textColor="#9E9E9E" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="⏳" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_stat_icon_amber" android:layout_marginBottom="10dp" />
                        <TextView android:id="@+id/tvPendingOrders" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="#FFB300" android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pending" android:textColor="#9E9E9E" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Stats Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="⚡" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_stat_icon_teal" android:layout_marginBottom="10dp" />
                        <TextView android:id="@+id/tvTodayRevenue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="₹0"
                            android:textColor="#26C6DA" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Today's Revenue" android:textColor="#9E9E9E" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="💰" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_stat_icon_green" android:layout_marginBottom="10dp" />
                        <TextView android:id="@+id/tvTotalRevenue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="₹0"
                            android:textColor="#4CAF50" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Total Revenue" android:textColor="#9E9E9E" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Stats Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="🍔" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_stat_icon_red" android:layout_marginBottom="10dp" />
                        <TextView android:id="@+id/tvTotalFoodItems" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="#E23744" android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Menu Items" android:textColor="#9E9E9E" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="📁" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_stat_icon_blue" android:layout_marginBottom="10dp" />
                        <TextView android:id="@+id/tvTotalCategories" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="#2196F3" android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Categories" android:textColor="#9E9E9E" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp" />

            <!-- ═══════════════════════════════
                 ❸  QUICK ACTIONS
                 ═══════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK ACTIONS"
                android:textColor="#757575"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:paddingStart="16dp"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="32dp">

                <!-- Helper macro for each row — just repeated cards -->

                <!-- Add Menu Item -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnAddFood"
                    android:layout_width="match_parent" android:layout_height="64dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="➕"
                            android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_stat_icon_green" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Add Menu Item" android:textColor="#212121"
                                android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Add a new dish to your menu"
                                android:textColor="#9E9E9E" android:textSize="11sp" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="#E23744" android:textSize="24sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Manage Menu -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnManageMenu"
                    android:layout_width="match_parent" android:layout_height="64dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="🍽️"
                            android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_stat_icon_amber" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Manage Menu" android:textColor="#212121"
                                android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Edit, delete or toggle menu items"
                                android:textColor="#9E9E9E" android:textSize="11sp" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="#E23744" android:textSize="24sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Manage Orders -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnManageOrders"
                    android:layout_width="match_parent" android:layout_height="64dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="📦"
                            android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_stat_icon_red" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Manage Orders" android:textColor="#212121"
                                android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="View and update order status"
                                android:textColor="#9E9E9E" android:textSize="11sp" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="#E23744" android:textSize="24sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Best Sellers -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBestSellers"
                    android:layout_width="match_parent" android:layout_height="64dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="🏆"
                            android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_stat_icon_purple" android:layout_marginEnd="14dp" />
