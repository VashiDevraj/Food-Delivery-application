<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- User row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="#FCE4EC"
                android:layout_marginEnd="12dp">
                <TextView
                    android:id="@+id/tvReviewUser"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#E23744"
                    android:textStyle="bold"
                    android:textSize="18sp"/>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvReviewUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvReviewDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- Overall rating badge -->
            <TextView
                android:id="@+id/tvReviewRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5.0 ⭐"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Sub-ratings block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF9F0"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <TextView android:id="@+id/tvFoodRating"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#424242" android:textSize="12sp" android:layout_marginBottom="4dp"/>

            <TextView android:id="@+id/tvDeliveryRating"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#424242" android:textSize="12sp" android:layout_marginBottom="4dp"/>

            <TextView android:id="@+id/tvPackingRating"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#424242" android:textSize="12sp" android:layout_marginBottom="4dp"/>

            <!-- Delivery boy rating (optional) -->
            <TextView android:id="@+id/tvDeliveryBoyRating"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E65100" android:textSize="12sp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Comment -->
        <TextView
            android:id="@+id/tvReviewComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#424242"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="8dp"/>

        <!-- ✅ Review Photo — visibility controlled in code (GONE by default, VISIBLE when photo exists) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAdminReviewPhoto"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp">
            <ImageView
                android:id="@+id/ivAdminReviewPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Review photo"
                android:visibility="gone"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Order reference -->
        <TextView
            android:id="@+id/tvOrderRef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            android:textStyle="italic"
            android:layout_marginBottom="10dp"/>

        <!-- Delete button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteReview"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="🗑️  Remove Review"
            android:textColor="#E23744"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:cornerRadius="6dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>