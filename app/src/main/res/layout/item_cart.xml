<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Divider (except first item) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F5F5F5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Veg/Non-Veg indicator -->
        <TextView
            android:id="@+id/tvVegIndicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:text="🟢"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginEnd="10dp" />

        <!-- Food Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCartItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Item Name"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2" />

            <TextView
                android:id="@+id/tvCartItemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹0.00"
                android:textColor="#757575"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Qty controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <!-- +/- stepper (green, Zomato style) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_qty_stepper"
                android:layout_marginBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDecrease"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:text="−"
                    android:textColor="#E23744"
                    android:textSize="18sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="0dp"
                    app:strokeWidth="0dp" />

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#E23744"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIncrease"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:text="+"
                    android:textColor="#E23744"
                    android:textSize="18sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="0dp"
                    app:strokeWidth="0dp" />

            </LinearLayout>

            <!-- Item total -->
            <TextView
                android:id="@+id/tvCartItemTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="#212121"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="end"
                android:layout_gravity="end" />

        </LinearLayout>

    </LinearLayout>

    <!-- Remove button row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="42dp"
        android:paddingBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemove"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Remove"
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:cornerRadius="4dp" />

    </LinearLayout>

</LinearLayout>