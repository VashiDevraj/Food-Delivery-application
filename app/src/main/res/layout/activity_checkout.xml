<?xml version="1.0" encoding="utf-8"?>
<!-- activity_checkout.xml — clean checkout, coupon handled in CartActivity -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarCheckout"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#E23744"
            app:titleTextColor="#FFFFFF"
            app:navigationIconTint="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── COUPON APPLIED BADGE (from CartActivity) ── -->
            <LinearLayout
                android:id="@+id/layoutCouponBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E8F5E9"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvCouponApplied"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvCouponSavings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#1B5E20"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ── DELIVERY ADDRESS CARD ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- HEADER ROW -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:background="#FFEBEE"
                            android:layout_marginEnd="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📍"
                                android:textSize="18sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delivery Address"
                            android:textColor="#E23744"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout> <!-- ✅ FIXED: CLOSED HEADER ROW -->

                    <!-- ADDRESS CONTENT -->
                    <LinearLayout
                        android:id="@+id/layoutAddressContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCheckoutAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#424242"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/btnChangeAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Change"
                            android:textColor="#E23744"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
            <!-- ── ORDER SUMMARY CARD ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🧾 Order Summary"
                        android:textColor="#E23744" android:textSize="14sp" android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Subtotal row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Subtotal" android:textColor="#616161" android:textSize="14sp" />
                        <TextView android:id="@+id/tvCheckoutSubtotal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#212121" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Delivery fee row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Delivery Fee" android:textColor="#616161" android:textSize="14sp" />
                        <TextView android:id="@+id/tvDeliveryFee"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#212121" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Coupon discount row (hidden if no coupon) -->
                    <LinearLayout android:id="@+id/layoutDiscountRow"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp"
                        android:visibility="gone">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Coupon Discount" android:textColor="#2E7D32" android:textSize="14sp" />
                        <TextView android:id="@+id/tvCheckoutDiscount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#2E7D32" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginBottom="10dp" />

                    <!-- Grand Total row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Grand Total" android:textColor="#212121"
                            android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvGrandTotal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#E23744" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── TIP CARD ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:gravity="center" android:background="#E8F5E9"
                            android:layout_marginEnd="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="🎁" android:textSize="18sp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Tip Your Delivery Partner"
                                android:textColor="#2E7D32" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvTipSelected"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="No tip selected"
                                android:textColor="#9E9E9E" android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Tip chips -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupTip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:singleSelection="true"
                        app:selectionRequired="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTip10"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹10" android:textSize="13sp"
                            app:chipBackgroundColor="@color/chip_bg_selector"
                            app:checkedIconTint="#2E7D32" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTip20"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹20" android:textSize="13sp"
                            app:chipBackgroundColor="@color/chip_bg_selector"
                            app:checkedIconTint="#2E7D32" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTip50"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹50" android:textSize="13sp"
                            app:chipBackgroundColor="@color/chip_bg_selector"
                            app:checkedIconTint="#2E7D32" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTipCustom"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Custom" android:textSize="13sp"
                            app:chipBackgroundColor="@color/chip_bg_selector"
                            app:checkedIconTint="#2E7D32" />

                    </com.google.android.material.chip.ChipGroup>

                    <!-- Custom tip input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="180dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Enter tip amount (₹)"
                        app:boxStrokeColor="#2E7D32"
                        app:hintTextColor="#2E7D32"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCustomTip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:visibility="gone"
                            android:textColor="#212121"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── DELIVERY NOTE CARD ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:gravity="center" android:background="#E3F2FD"
                            android:layout_marginEnd="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="📝" android:textSize="18sp" />
                        </LinearLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Note for Delivery Partner"
                            android:textColor="#1565C0" android:textSize="14sp" android:textStyle="bold" />

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Ring the bell, leave at door…"
                        app:boxStrokeColor="#1565C0"
                        app:hintTextColor="#1565C0"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDeliveryNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:maxLines="3"
                            android:textColor="#212121"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ── PROCEED BUTTON ── -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#FFFFFF" android:elevation="8dp" android:padding="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProceedPayment"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Proceed to Pay"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#E23744"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>