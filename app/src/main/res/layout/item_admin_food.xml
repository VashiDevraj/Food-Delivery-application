<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp">

        <FrameLayout android:layout_width="80dp" android:layout_height="80dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp" android:layout_height="80dp"
                app:cardCornerRadius="12dp" app:cardElevation="0dp"
                app:cardBackgroundColor="#F4F4F4">
                <ImageView android:id="@+id/ivAdminFoodImage"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="centerCrop" android:contentDescription="Food Image"/>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/tvVegBadge"
                android:layout_width="18dp" android:layout_height="18dp"
                android:layout_gravity="top|start" android:layout_margin="4dp"
                android:text="🟢" android:textSize="10sp" android:gravity="center"
                android:visibility="gone"/>
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView android:id="@+id/tvAdminFoodName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Food Name" android:textColor="#212121"
                android:textSize="14sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end"
                android:layout_marginBottom="4dp"/>

            <TextView android:id="@+id/tvAdminFoodDesc"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Description" android:textColor="#9E9E9E"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
                android:layout_marginBottom="6dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView android:id="@+id/tvAdminFoodPrice"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹0" android:textColor="#E23744"
                    android:textSize="15sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/tvOfferBadge"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="20% OFF" android:textColor="#E65100"
                    android:textSize="10sp" android:textStyle="bold"
                    android:paddingStart="7dp" android:paddingEnd="7dp"
                    android:paddingTop="3dp" android:paddingBottom="3dp"
                    android:background="@drawable/bg_offer_dark_pill"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditFood"
                    android:layout_width="0dp" android:layout_height="34dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:text="Edit" android:textColor="#E23744"
                    android:textSize="11sp" android:textStyle="bold"
                    app:backgroundTint="#FFF0F1" app:cornerRadius="8dp"
                    app:strokeColor="#E23744" app:strokeWidth="1dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteFood"
                    android:layout_width="0dp" android:layout_height="34dp"
                    android:layout_weight="1" android:text="Delete"
                    android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"
                    app:backgroundTint="#E23744" app:cornerRadius="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>