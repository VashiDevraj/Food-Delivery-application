<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_user_profile.xml — dark-mode ready
    All hardcoded whites/greys replaced with @color/colorSurface,
    @color/colorOnSurface, @color/colorOnSurfaceVariant, @color/colorDivider.
    These resolve from values-night/colors.xml automatically when dark mode
    is active — no ?attr/ references, no theme crash.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ── Toolbar ────────────────────────────────────────────────────────── -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primaryColor"
        android:elevation="0dp"
        app:titleTextColor="#FFFFFF"
        app:navigationIconTint="#FFFFFF" />

    <!-- ── Hero header ────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primaryColor"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="6dp">
            <TextView
                android:id="@+id/tvProfileInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="U"
                android:textColor="@color/primaryColor"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Name"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="email@example.com"
            android:textColor="#FFCDD2"
            android:textSize="13sp"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/tvEditProfileLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✏️  Edit Profile"
            android:textColor="@color/primaryColor"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_edit_chip"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ── Quick info row ─────────────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Phone -->
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:gravity="center" android:paddingEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📞" android:textSize="20sp" android:gravity="center" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Phone" android:textSize="10sp"
                            android:textColor="@color/colorOnSurfaceVariant"
                            android:layout_marginTop="4dp" />
                        <TextView android:id="@+id/tvProfilePhone"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Not set" android:textSize="12sp" android:textStyle="bold"
                            android:textColor="@color/colorOnSurface"
                            android:layout_marginTop="2dp" android:gravity="center" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent"
                        android:background="@color/colorDivider" android:minHeight="48dp" />

                    <!-- City -->
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🏙️" android:textSize="20sp" android:gravity="center" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="City" android:textSize="10sp"
                            android:textColor="@color/colorOnSurfaceVariant"
                            android:layout_marginTop="4dp" />
                        <TextView android:id="@+id/tvProfileCity"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Not set" android:textSize="12sp" android:textStyle="bold"
                            android:textColor="@color/colorOnSurface"
                            android:layout_marginTop="2dp" android:gravity="center" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent"
                        android:background="@color/colorDivider" android:minHeight="48dp" />


                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ════════════════════════════════════════════════════════════
                 PREFERENCES
                 ════════════════════════════════════════════════════════════ -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PREFERENCES" android:textColor="@color/primaryColor"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"
                android:paddingStart="20dp" android:paddingTop="18dp" android:paddingBottom="6dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
                app:cardCornerRadius="16dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Veg Mode -->
                    <LinearLayout android:id="@+id/llVegMode"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="🥦" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_icon_green_soft" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Veg Mode" android:textSize="14sp"
                                android:textColor="@color/colorOnSurface" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Show only vegetarian items" android:textSize="11sp"
                                android:textColor="@color/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchVegModeProfile"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track_tint" app:thumbTint="#FFFFFF" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/colorDivider" android:layout_marginStart="66dp" />

                    <!-- Personalised Ratings -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="⭐" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_icon_amber_soft" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Personalised Ratings" android:textSize="14sp"
                                android:textColor="@color/colorOnSurface" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Ratings based on your taste" android:textSize="11sp"
                                android:textColor="@color/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchPersonalisedRatings"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track_tint" app:thumbTint="#FFFFFF" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/colorDivider" android:layout_marginStart="66dp" />

                    <!-- Appearance -->


                    <!-- Payment Methods -->
                    <LinearLayout android:id="@+id/llPaymentMethods"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="💳" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_icon_blue_soft" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Payment Methods" android:textSize="14sp"
                                android:textColor="@color/colorOnSurface" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="UPI, Card, COD" android:textSize="11sp"
                                android:textColor="@color/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/primaryColor" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ════════════════════════════════════════════════════════════
                 ACCOUNT & SECURITY
                 ════════════════════════════════════════════════════════════ -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ACCOUNT &amp; SECURITY" android:textColor="@color/primaryColor"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"
                android:paddingStart="20dp" android:paddingTop="18dp" android:paddingBottom="6dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
                app:cardCornerRadius="16dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/llChangePassword"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="🔒" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_icon_amber_soft" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Change Password" android:textSize="14sp"
                                android:textColor="@color/colorOnSurface" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Update your login password" android:textSize="11sp"
                                android:textColor="@color/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/primaryColor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/colorDivider" android:layout_marginStart="66dp" />

                    <LinearLayout android:id="@+id/llSettings"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="⚙️" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_icon_circle_soft" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Settings" android:textSize="14sp"
                                android:textColor="@color/colorOnSurface" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Notifications, privacy &amp; more" android:textSize="11sp"
                                android:textColor="@color/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/primaryColor" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ════════════════════════════════════════════════════════════
                 ORDERS & DELIVERY
                 ════════════════════════════════════════════════════════════ -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ORDERS &amp; DELIVERY" android:textColor="@color/primaryColor"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"
                android:paddingStart="20dp" android:paddingTop="18dp" android:paddingBottom="6dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
                app:cardCornerRadius="16dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/llYourOrders"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="📋" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_icon_red_soft" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Your Orders" android:textSize="14sp"
                                android:textColor="@color/colorOnSurface" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Track and reorder" android:textSize="11sp"
                                android:textColor="@color/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/primaryColor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/colorDivider" android:layout_marginStart="66dp" />

                    <LinearLayout android:id="@+id/llAddressBook"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="📍" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_icon_red_soft" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Address Book" android:textSize="14sp"
                                android:textColor="@color/colorOnSurface" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Manage delivery addresses" android:textSize="11sp"
                                android:textColor="@color/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/primaryColor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/colorDivider" android:layout_marginStart="66dp" />

                    <LinearLayout android:id="@+id/llYourCollections"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="❤️" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_icon_red_soft" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Favourites" android:textSize="14sp"
                                android:textColor="@color/colorOnSurface" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Saved restaurants and dishes" android:textSize="11sp"
                                android:textColor="@color/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/primaryColor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/colorDivider" android:layout_marginStart="66dp" />

                    <LinearLayout android:id="@+id/llOnlineHelp"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="❓" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_icon_blue_soft" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Help &amp; Support" android:textSize="14sp"
                                android:textColor="@color/colorOnSurface" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="FAQs, chat with us" android:textSize="11sp"
                                android:textColor="@color/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/primaryColor" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ════════════════════════════════════════════════════════════
                 MORE
                 ════════════════════════════════════════════════════════════ -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MORE" android:textColor="@color/primaryColor"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"
                android:paddingStart="20dp" android:paddingTop="18dp" android:paddingBottom="6dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
                app:cardCornerRadius="16dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/llAbout"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="36dp" android:layout_height="36dp"
                            android:text="ℹ️" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_icon_blue_soft" android:layout_marginEnd="14dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="About" android:textSize="14sp"
                                android:textColor="@color/colorOnSurface" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="App version 1.0.0" android:textSize="11sp"
                                android:textColor="@color/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/primaryColor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/colorDivider" android:layout_marginStart="66dp" />

                    <LinearLayout android:id="@+id/llLogout"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <ImageView
                            android:layout_width="36dp" android:layout_height="36dp"
                            android:src="@drawable/ic_logout"
                            android:background="@drawable/bg_icon_red_soft"
                            android:padding="7dp" android:layout_marginEnd="14dp"
                            android:contentDescription="Logout" />
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Log out" android:textSize="14sp"
                            android:textColor="@color/primaryColor" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/primaryColor" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>