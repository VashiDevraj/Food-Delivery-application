<?xml version="1.0" encoding="utf-8"?>
<!-- activity_delivery_boy_dashboard.xml — vibrant orange delivery dashboard -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- ══ HEADER ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF6F00"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="20dp">

        <!-- Name + toggle row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView android:id="@+id/tvDbName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Hello, Partner 👋"
                    android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />

                <TextView android:id="@+id/tvDbRating"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⭐ New Partner"
                    android:textColor="#FFE0B2" android:textSize="13sp" android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Online/Offline chip toggle -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipOnlineToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴  Offline"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:chipStrokeWidth="2dp"
                app:chipStrokeColor="#FFFFFF"
                app:chipBackgroundColor="#33000000"
                style="@style/Widget.MaterialComponents.Chip.Filter" />

        </LinearLayout>

        <!-- Stats strip: Today / Month / Deliveries -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Today earnings -->
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center" android:background="#33FFFFFF"
                android:padding="12dp" android:layout_marginEnd="6dp">

                <TextView android:id="@+id/tvDbTodayEarnings"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹0" android:textColor="#FFFFFF"
                    android:textSize="20sp" android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Today" android:textColor="#FFE0B2" android:textSize="11sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Month earnings -->
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center" android:background="#33FFFFFF"
                android:padding="12dp" android:layout_marginEnd="6dp">

                <TextView android:id="@+id/tvDbMonthEarnings"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹0" android:textColor="#FFFFFF"
                    android:textSize="20sp" android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="This Month" android:textColor="#FFE0B2" android:textSize="11sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Deliveries -->
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center" android:background="#33FFFFFF"
                android:padding="12dp">

                <TextView android:id="@+id/tvDbTotalDeliveries"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="#FFFFFF"
                    android:textSize="20sp" android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Deliveries" android:textColor="#FFE0B2" android:textSize="11sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ══ BODY ══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Quick Nav Cards -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="20dp">

                <!-- Earnings card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEarnings"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="96dp" android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp" app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFF3E0"
                    android:clickable="true" android:focusable="true">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="💰" android:textSize="28sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Earnings" android:textSize="13sp"
                            android:textColor="#E65100" android:textStyle="bold" android:layout_marginTop="4dp"/>
                        <TextView android:id="@+id/tvDbTotalEarnings"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹0 total" android:textSize="11sp" android:textColor="#BF360C"/>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- History card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHistory"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="96dp" android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp" app:cardElevation="4dp"
                    app:cardBackgroundColor="#E3F2FD"
                    android:clickable="true" android:focusable="true">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📦" android:textSize="28sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="History" android:textSize="13sp"
                            android:textColor="#1565C0" android:textStyle="bold" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="All orders" android:textSize="11sp" android:textColor="#0D47A1"/>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRatings"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="96dp" android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp" app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFF8E1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="103dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐"
                            android:textSize="28sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Ratings"
                            android:textColor="#FF8F00"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your reviews"
                            android:textColor="#E65100"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Profile card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProfile"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="96dp"
                    app:cardCornerRadius="16dp" app:cardElevation="4dp"
                    app:cardBackgroundColor="#E8F5E9"
                    android:clickable="true" android:focusable="true">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="👤" android:textSize="28sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Profile" android:textSize="13sp"
                            android:textColor="#2E7D32" android:textStyle="bold" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Settings" android:textSize="11sp" android:textColor="#1B5E20"/>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Active Orders section header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <LinearLayout android:layout_width="4dp" android:layout_height="20dp"
                    android:background="#FF6F00" android:layout_marginEnd="8dp"/>

                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Active Orders"
                    android:textSize="17sp" android:textStyle="bold" android:textColor="#212121" />

            </LinearLayout>

            <TextView android:id="@+id/tvActiveOrdersEmpty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="No active orders assigned yet"
                android:textColor="#9E9E9E" android:textSize="14sp"
                android:gravity="center"
                android:paddingTop="30dp" android:paddingBottom="30dp"
                android:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvActiveOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ══ LOGOUT ══ -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#FFFFFF" android:elevation="6dp" android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDbLogout"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Logout"
            app:backgroundTint="#FFF3E0"
            android:textColor="#E65100"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="#FF6F00"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

</LinearLayout>